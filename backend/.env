# TruthLens Application Configuration

# Model Configuration
MODEL_TYPE=tfidf

# Database Configuration
DATABASE_URL=sqlite:///./truthlens.db

# News API Configuration (Optional: open public RSS news feeds will be used as default fallback)
NEWS_API_KEY=
GNEWS_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Security / CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=10
